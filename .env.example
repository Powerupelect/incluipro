# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A publishable/anon key é pública por design — pode ficar
# no código do cliente. NUNCA coloque a service role key aqui nem no frontend.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
